# Example ports for Docker Compose
API_PORT=8000
KIOSK_PORT=5173

# Recognition. The checkpoint is git-ignored; get it from the team Drive.
AVC_MODEL_PATH=ml/model/best.pt
AVC_CONF_THRESHOLD=0.65
AVC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Capture storage (#14): a local directory, or s3://<bucket> in the deployed stack.
AVC_STORE=ml/data/pipeline
